# ============================================================
# LegalDocuLex-AI - Environment Configuration (.env.example)
# ============================================================
# To enable OpenAI-powered question answering:
# 1. Copy this file to .env:
#      copy .env.example .env
# 2. Replace the placeholder value below with your actual API key:
#      OPENAI_API_KEY=sk-...
#
# IMPORTANT:
# - Never commit the actual .env file to Git or version control!
# - Never hardcode or print your secret API keys in logs or UI!
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here
